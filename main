class No:
    def __init__(self, data, horario, linha):
                                                      # Guarda as informações originais do registro
        self.data = data
        self.horario = horario
        self.linha = linha
        
                                                       # Cria uma tupla (data, horario, linha) para a chave de ordenação.
        
        self.chave = (data, horario, linha) 
        
                                                       # Ponteiros para os nós filhos (esquerda = anteriores, direita = posteriores)
        self.esquerda = None
        self.direita = None

class ArvoreChegadas:
    def __init__(self):
                                                       # A árvore sempre inicia vazia (sem nenhum nó no topo)
        self.raiz = None

    def registrar_chegada(self, data, horario, linha):         # (R1)
        nova_chave = (data, horario, linha)
        
                                                       # Se a árvore estiver vazia, o novo registro vira a raiz
        if self.raiz is None:
            self.raiz = No(data, horario, linha)
            return "OK"
            
                                                       # Variável para percorrer a árvore, começando sempre pelo topo (raiz)
        atual = self.raiz
        
        while True:
                                                           # R1 exige tratamento se a chegada já foi registrada, retornando DUPLICADO
            if nova_chave == atual.chave:
                return "DUPLICADO"
                
            if nova_chave < atual.chave:
                                                              # Se a chave for menor, precisamos descer pelo lado esquerdo
                if atual.esquerda is None:
                                                                  # Achou um espaço vazio, pendura o novo nó aqui e finaliza
                    atual.esquerda = No(data, horario, linha)
                    return "OK"
                                                              # Se não estiver vazio, move o foco para o nó da esquerda e repete o laço
                atual = atual.esquerda
            else:
                                                              # Se a chave for maior, precisamos descer pelo lado direito
                if atual.direita is None:
                                                              # Achou um espaço vazio, pendura o novo nó aqui e finaliza
                    atual.direita = No(data, horario, linha)
                    return "OK"
                                                              # Se não estiver vazio, move o foco para o nó da direita e repete o laço
                atual = atual.direita

    def buscar_chegada(self, data, horario, linha):             # (R2)
        chave_busca = (data, horario, linha)
        atual = self.raiz
        
                                                              # Percorre a árvore enquanto houver nós pelo caminho
        while atual is not None:
            if chave_busca == atual.chave:
                                                               # Encontrou o registro exato
                return "ACHOU"
            elif chave_busca < atual.chave:
                                                               # A chave buscada é menor, então ignora a direita e desce pela esquerda
                atual = atual.esquerda
            else:
                                                               # A chave buscada é maior, então ignora a esquerda e desce pela direita
                atual = atual.direita
                
                                                                # O laço terminou e encontrou um espaço vazio (None), logo o registro não existe
        return "NAO"



def proximo(self, data, horario):                                       #(R3)
        atual = self.raiz
        melhor = None
        
        while atual is not None:
                                                                                    # Comparamos apenas data e horário usando tuplas
            if (atual.data, atual.horario) >= (data, horario):
                                                                                    # Este nó é um candidato válido. Guardamos ele.
                melhor = atual
                                                                                    # Como queremos o PRIMEIRO a partir do instante, 
                                                                                    # descemos para a esquerda para tentar achar um ainda mais cedo.
                atual = atual.esquerda
            else:
                                                                                    # Se o nó atual é de um instante anterior ao que buscamos,
                                                                                    # a resposta só pode estar na subárvore da direita.
                atual = atual.direita
                
        if melhor is not None:
            return f"{melhor.data} {melhor.horario} {melhor.linha}"
        return "NENHUM"

    def proximo_da_linha(self, data, horario, linha):                     #(R4)
        melhor = None
        
                                                                                    # O enunciado diz que para R4 na Fase 1 basta a solução mais simples na própria árvore.
                                                                                    # Usamos uma função recursiva que varre os caminhos possíveis.
        def buscar_linha(no):
            nonlocal melhor
            if no is None:
                return
            
                                                                                    # Se o nó atende à data/hora e é da linha exata
            if (no.data, no.horario) >= (data, horario) and no.linha == linha:
                                                                                                # Guarda se for o primeiro encontrado ou se for mais cedo que o guardado anteriormente
                if melhor is None or (no.data, no.horario) < (melhor.data, melhor.horario):
                    melhor = no
            
                                                                                                # Otimização da busca:
            if (no.data, no.horario) < (data, horario):
                                                                                                # Se o nó aconteceu antes do horário buscado, ignoramos a esquerda inteira
                buscar_linha(no.direita)
            else:
                                                                                                    # Se aconteceu depois, temos que olhar a esquerda (pode ter um mais cedo)
                                                                                                    # e a direita (caso o nó atual não seja da linha certa e a linha certa esteja lá)
                buscar_linha(no.esquerda)
                buscar_linha(no.direita)
                
        buscar_linha(self.raiz)
        
        if melhor is not None:
            return f"{melhor.data} {melhor.horario}"
        return "NENHUM"




